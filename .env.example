# === Windows local (no Docker) — copy to .env then edit ===
#   copy .env.example .env
#   .\run.ps1
#
# Prerequisites on this machine:
#   - Go 1.23+          winget install GoLang.Go
#   - PostgreSQL        winget install PostgreSQL.PostgreSQL
#   - Redis             see README (Memurai / WSL / redis-server)

PORT=8080
ENV=development
LOG_LEVEL=info
# Set true to also log CORS OPTIONS preflight noise
LOG_OPTIONS=false

# Match your local Postgres user/password (Windows installer often uses "postgres")
DATABASE_URL=host=localhost user=postgres password=postgres dbname=SACAS port=5432 sslmode=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Development only — production requires a long random secret
JWT_SECRET=dev-only-insecure-jwt-secret-change-me

# --- Notification providers (branding + fail-fast in production) ---
SENDGRID_API_KEY=
EMAIL_FROM_NAME=SACAS
FROM_EMAIL=noreply@sacas.local
# SMS: choose one provider (Twilio or Tanzania/Beem), or leave blank for log provider in dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
FROM_PHONE=+255000000000
# Tanzania local SMS (Beem Africa) — alternative to Twilio
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SOURCE_ADDR=
BEEM_API_URL=https://apisms.beem.africa/v1/send
# Set to "none" to explicitly disable SMS in production (OTP via email only)
SMS_PROVIDER=

# Demo seed (dev only): set true to seed demo users (admin@example.com etc.)
# Never true in production — blocked by startup guard
SEED_DEMO=false
# First super_admin bootstrap (works in any env; required in production when no admin exists)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Admin
SUPERADMIN_PHONE=

# SPA / local testing: keep CSRF off
CSRF_ENABLED=false

# Frontend origins (Vite default 5173, CRA-style 3000)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limit needs Redis; leave true if Redis is running
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Leave SOLVER_URL empty for easiest local testing (built-in greedy engine, no Python).
# To use OR-Tools solver: start solver-service then set:
# SOLVER_URL=http://localhost:8090
SOLVER_URL=
SOLVER_TIMEOUT_SECONDS=35
# SOLVER_FALLBACK: in development false is fine; in production must be false
# when SOLVER_URL is set (fail loudly, don't silently use greedy if solver is down)
SOLVER_FALLBACK=false
