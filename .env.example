# === Windows local (no Docker) — copy to .env then edit ===
#   copy .env.example .env
#   .\run.ps1
#
# Prerequisites on this machine:
#   - Go 1.23+          winget install GoLang.Go
#   - PostgreSQL        winget install PostgreSQL.PostgreSQL
#   - Redis             see README (Memurai / WSL / redis-server)

PORT=8080
ENV=development
LOG_LEVEL=info
# Set true to also log CORS OPTIONS preflight noise
LOG_OPTIONS=false

# Match your local Postgres user/password (Windows installer often uses "postgres")
DATABASE_URL=host=localhost user=postgres password=postgres dbname=SACAS port=5432 sslmode=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Development only — production requires a long random secret
JWT_SECRET=dev-only-insecure-jwt-secret-change-me

# --- Notification providers (branding + fail-fast in production) ---
SENDGRID_API_KEY=
EMAIL_FROM_NAME=SACAS
FROM_EMAIL=noreply@sacas.local
# SMS: choose one provider (Twilio or Tanzania/Beem), or leave blank for log provider in dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
FROM_PHONE=+255000000000
# Tanzania local SMS (Beem Africa) — alternative to Twilio
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SOURCE_ADDR=
BEEM_API_URL=https://apisms.beem.africa/v1/send
# Set to "none" to explicitly disable SMS in production (OTP via email only)
SMS_PROVIDER=

# Demo seed (dev only): set true to seed demo users (admin@example.com etc.)
# Never true in production — blocked by startup guard
SEED_DEMO=false
# First super_admin bootstrap (works in any env; required in production when no admin exists)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Admin
SUPERADMIN_PHONE=

# --- Multi-tenancy -----------------------------------------------------------
# No environment variable is needed to enable multi-tenancy: the schema
# migration creates the institutions table, adds institution_id to every
# timetable-domain table, seeds a "Default Institution" (id 1), and backfills
# existing rows into it on first boot. That migration is recorded in
# schema_migrations and runs exactly once.
#
# The tenant is resolved per request from the authenticated user's own database
# row, never from a header, a body field, or the JWT. Institutions are managed
# through POST /api/protected/superadmin/institutions by a platform super_admin
# (a super_admin whose institution_id is NULL).
#
# INHERITANCE: an institution with no row in institutions starts as "pending"
# and cannot sign anyone in until a platform admin activates it. An institution
# on an expired trial is also refused, so a trial lapse does not silently keep
# serving. Both states surface as 403 on every protected route.
#
# To bootstrap the very first institution, set it in the UI after logging in as
# the super_admin from SUPERADMIN_EMAIL above.

# --- Support access (impersonation) ------------------------------------------
# A platform super_admin has NO access to an institution's workspace: it is not
# bound to an institution, so it has no tenant to scope queries with. Support
# needs that visibility, so it is granted deliberately through a short-lived,
# read-only, audited session instead.
#
# IM_PERSONATION_ENABLED=false refuses to issue support sessions at all. Leave
# it false unless support actually needs in-app tenant access — read-only
# sessions are still a sensitive capability and every one is written to the
# audit log.
IM_PERSONATION_ENABLED=false
# How long a support token stays valid. Kept short on purpose.
IM_PERSONATION_TTL_MINUTES=15
# Concurrent support sessions per API instance. A multi-instance deployment
# should move this to shared state; until then the cap is per instance.
IM_PERSONATION_MAX_CONCURRENT=1

# --- Audit log ----------------------------------------------------------------
# The audit trail is append-only and cannot be trimmed by the application. If
# you need to bound its growth, do it with a database-level retention policy
# and be aware that doing so erases the record of who did what.
# AUDIT_RETENTION_DAYS=365

# SPA / local testing: keep CSRF off
CSRF_ENABLED=false

# Frontend origins (Vite default 5173, CRA-style 3000)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limit needs Redis; leave true if Redis is running
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Leave SOLVER_URL empty for easiest local testing (built-in greedy engine, no Python).
# To use OR-Tools solver: start solver-service then set:
# SOLVER_URL=http://localhost:8090
SOLVER_URL=
SOLVER_TIMEOUT_SECONDS=35
# SOLVER_FALLBACK: in development false is fine; in production must be false
# when SOLVER_URL is set (fail loudly, don't silently use greedy if solver is down)
SOLVER_FALLBACK=false
